# Production build environment (Vite loads this for `pnpm build`).
# ⚠️ Placeholder — no Convex PRODUCTION deployment exists yet.
#
# When you create it:
#   1. `npx convex deploy` provisions/pushes the prod deployment.
#   2. Replace VITE_CONVEX_URL below with the prod .convex.cloud URL
#      (on Cloudflare Pages, set it as a build env var instead — real env
#      vars override this file).
#   3. Set on the PROD deployment (dashboard or `npx convex env set --prod`):
#        OWNER_EMAIL=<the Google account allowed in>
#        SITE_URL=https://breezyscript.com/app
#        AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET   (same Google OAuth client is fine)
#        JWT_PRIVATE_KEY / JWKS                (generate a FRESH pair — don't reuse dev's)
#   4. Add the prod redirect URI to the Google OAuth client:
#        https://<prod-deployment>.convex.site/api/auth/callback/google

VITE_CONVEX_URL=https://REPLACE-WITH-PROD-DEPLOYMENT.convex.cloud
