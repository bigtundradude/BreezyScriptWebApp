# ——— Browser (Vite) env — safe to expose ———
# Set in .env.local; created by `npx convex dev`.
VITE_CONVEX_URL=

# ——— AI provider API keys — SERVER ONLY, never VITE_* ———
# These are NOT read from this file. Set them on the Convex deployment:
#   npx convex env set ANTHROPIC_API_KEY sk-ant-...
#   npx convex env set OPENAI_API_KEY sk-...
#   npx convex env set XAI_API_KEY xai-...
# The Settings → AI integrations page shows presence and tests the connection.
